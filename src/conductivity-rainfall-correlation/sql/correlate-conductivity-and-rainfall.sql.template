SELECT
	COSMO.COSMO_TIMESTAMP,
	COSMO.CONDUCTANCE_RESULT,
	CNV.CNV_RAINFALL,
	CNV.CNV_TIMESTAMP
	FROM
	(
		SELECT
			NSSK_COSMO.$COSMO_SITE.ActivityStartDate as "COSMO_DATE",
			NSSK_COSMO.$COSMO_SITE.ActivityStartTime as "COSMO_TIME",
			CAST(CONCAT_WS(' ', NSSK_COSMO.$COSMO_SITE.ActivityStartDate, NSSK_COSMO.$COSMO_SITE.ActivityStartTime) as DATETIME) as "COSMO_TIMESTAMP",
			NSSK_COSMO.$COSMO_SITE.ResultValue as "CONDUCTANCE_RESULT"
			FROM NSSK_COSMO.$COSMO_SITE
			WHERE
			CAST(CONCAT_WS(' ', NSSK_COSMO.$COSMO_SITE.ActivityStartDate, NSSK_COSMO.$COSMO_SITE.ActivityStartTime) as DATETIME) >= '$COSMO_START_DATETIME' AND
			CAST(CONCAT_WS(' ', NSSK_COSMO.$COSMO_SITE.ActivityStartDate, NSSK_COSMO.$COSMO_SITE.ActivityStartTime) as DATETIME) < '$COSMO_END_DATETIME' AND
			NSSK_COSMO.$COSMO_SITE.CharacteristicName = "Conductivity"
	) COSMO
	right join (
		SELECT
			NSSK_CNV_FLOWWORKS.CNVRain.MeasurementTimestamp as "CNV_TIMESTAMP",
			NSSK_CNV_FLOWWORKS.CNVRain.Rainfall as "CNV_RAINFALL"
			from NSSK_CNV_FLOWWORKS.CNVRain
			where
			NSSK_CNV_FLOWWORKS.CNVRain.MeasurementTimestamp >= '$CNV_FLOWWORKS_START_DATETIME' AND
			NSSK_CNV_FLOWWORKS.CNVRain.MeasurementTimestamp < '$CNV_FLOWWORKS_END_DATETIME' AND
			NSSK_CNV_FLOWWORKS.CNVRain.Rainfall > 0

	) CNV
	on
	(
		ABS(
		TIMESTAMPDIFF(
			MINUTE,
			CNV.CNV_TIMESTAMP,
			COSMO.COSMO_TIMESTAMP
		)) <= 5
	)
WHERE
COSMO_TIMESTAMP is not Null and
CONDUCTANCE_RESULT is not null
ORDER BY COSMO_TIMESTAMP ASC
;